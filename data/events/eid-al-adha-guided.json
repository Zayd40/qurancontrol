  "sections": [
    {
      "id": "night-of-eid-takbeerat",
      "title": "Night of Eid Takbeerat",
      "slides": [
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "اللَّهُ اكْبَرُ ٱللَّهُ اكْبَرُ",
          "transliteration": "allahu akbar allahu akbar",
          "english": "Allah is Great. Allah is Great.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "لاَ إِلٰهَ إِلاَّ اللَّهُ",
          "transliteration": "la ilaha illa allahu",
          "english": "There is no god save Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَٱللَّهُ اكْبَر ُاللَّهُ اكْبَرُ",
          "transliteration": "wallahu akbar allahu akbar",
          "english": "And Allah is Great.Allah is Great.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَلِلَّهِ ٱلْحَمْدُ",
          "transliteration": "wa lillahi alhamd",
          "english": "All praise be to Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "الْحَمْدُ لِلَّهِ عَلَىٰ مَا هَدَانَا",
          "transliteration": "alhamdu lillahi `ala ma hadana",
          "english": "All praise be to Allah for He has shown us the Right Path.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَلَهُ ٱلشُّكْرُ عَلَىٰ مَا اوْلانَا",
          "transliteration": "wa lahu alshshukru `ala ma awlana",
          "english": "All thanks be to Him for that which He has conferred upon us.",
          "note": ""
        }
      ]
    },
    {
      "id": "eid-salat",
      "title": "Eid Salat",
      "slides": [
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "اللّهُمّ أَهْلَ الْكِبْرِيَاءِ وَالْعَظَمَةِ،",
          "transliteration": "allahumma ahla alkibriya‘i wal-`azamati",
          "english": "O Allah: You are the Lord of glory and greatness",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَهْلَ الْجُودِ وَالْجَبَرُوتِ،",
          "transliteration": "wa ahla aljudi wal-jabaruti",
          "english": "And the Lord of magnanimity and omnipotence",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَهْلَ الْعَفْوِ وَالرّحْمَةِ،",
          "transliteration": "wa ahla al-`afwi wal-rrahmati",
          "english": "And the Lord of pardon and mercy,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَهْلَ التّقْوَى وَالْمَغْفِرَةِ،",
          "transliteration": "wa ahla alttaqwa wal-maghfirati",
          "english": "And the worthiest of being feared and the Lord of forgiveness;",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "أَسْأَلُكَ بِحَقّ هذَا الْيَوْمِ الّذِي جَعَلْتَهُ لِلْمُسْلِمِينَ عِيداً،",
          "transliteration": "as’aluka bihaqqi hadha aliyawmi alladhy ja`altahu lilmuslimena `edan",
          "english": "I beseech You in the name of this day, which You have decided to be feast for the Muslims,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَلِمُحَمّدٍ صَلَّى اللهُ عَلَيْهِ وَآلِه ذُخْراً وَمَزِيداً",
          "transliteration": "wa limuhammadin salla allahu `alayhi wa alihi dhukhran wa mazedan",
          "english": "And to be safety and increasing honor for Muhammad—peace of Allah be upon him and his Household—",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "أَنْ تُصَلّيَ عَلَى مُحَمّدٍ وَآلِ مُحَمّدٍ",
          "transliteration": "an tusalliya `ala muhammadin wa ali muhammadin",
          "english": "(I beseech You) that You may send blessings upon Muhammad and the Household of Muhammad,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَنْ تُدْخِلَنِي فِي كُلّ خَيْرٍ أَدْخَلْتَ فِيهِ مُحَمّداً وَآلَ مُحَمّدٍ،",
          "transliteration": "wa an tudkhilany fe kulli khayrin adkhalta fehi muhammadan wa ala muhammadin",
          "english": "And You may include me with every item of goodness with which You have included Muhammad and the Household of Muhammad,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَنْ تُخْرِجَنِي مِنْ كُلِّ سُوءٍ أَخْرَجْتَ مِنْهُ مُحَمّداً وَآلَ مُحَمّدٍ",
          "transliteration": "wa an tukhrijany min kulli su‘in akhrajta minhu muhammadan wa ala muhammadin",
          "english": "And that You save me from any item of evil from which You have saved Muhammad and the Household of Muhammad,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "صَلَوَاتُكَ عَلَيْهِ وَعَلَيْهِمْ.",
          "transliteration": "salawatuka `alayhi wa `alayhim",
          "english": "May Your blessings be upon him and upon them.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "اللّهُمّ إِنّي أَسْأَلُكَ خَيْرَ مَا سَأَلَكَ عِبَادُكَ الصَّالِحُونَ،",
          "transliteration": "allahumma inne as’aluka khayra ma sa’alaka `ibaduka alssalihuna",
          "english": "O Allah: I pray You for the best of all that for which Your righteous servants have prayed You,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/zilhajj-dua-eid-sacrifice.html",
          "arabic": "وَأَعُوذُ بِكَ مِمَّا اسْتَعَاذَ مِنْهُ عِبَادُكَ الصَّالِحُونَ.",
          "transliteration": "wa a`udhu bika mimma ista`adha minhu `ibaduka alssalihuna",
          "english": "And I seek Your protection against all that against which Your righteous servants have asked Your protection.",
          "note": ""
        }
      ]
    },
    {
      "id": "ziyarat-waritha-of-imam-hussain",
      "title": "Ziyarat Waritha of Imam Hussain",
      "slides": [
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ آدَمَ صَفْوَةِ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha adama safwati allahi",
          "english": "Peace be upon you, O inheritor of Adam the choice of Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ نُوحٍ نَبِيِّ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha nuhin nabiyyi allahi",
          "english": "Peace be upon you, O inheritor of Noah the prophet of Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ إِبْرَاهِيمَ خَلِيلِ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha ibrahima khalili allahi",
          "english": "Peace be upon you, O inheritor of Abraham the intimate friend of Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ مُوسَىٰ كَلِيمِ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha musa kalimi allahi",
          "english": "Peace be upon you, O inheritor of Moses the spoken by Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ عِيسَىٰ رُوحِ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha `isa ruhi allahi",
          "english": "Peace be upon you, O inheritor of Jesus the spirit of Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ مُحَمَّدٍ حَبِيبِ ٱللَّهِ",
          "transliteration": "alssalamu `alayka ya waritha muhammadin habibi allahi",
          "english": "Peace be upon you, O inheritor of Muhammad the most beloved by Allah.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا وَارِثَ أَمِيرِ ٱلْمُؤْمِنِينَ عَلَيْهِ ٱلسَّلاَمُ",
          "transliteration": "alssalamu `alayka ya waritha amiri almu'minina",
          "english": "Peace be upon you, O inheritor of the Commander of the Faithful, peace be upon him.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ مُحَمَّدٍ ٱلْمُصْطَفَىٰ",
          "transliteration": "alssalamu `alayka yabna muhammadin almustafa",
          "english": "Peace be upon you, O son of Muhammad the well-chosen Prophet.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ عَلِيٍّ ٱلْمُرْتَضَىٰ",
          "transliteration": "alssalamu `alayka yabna `aliyyin almurtada",
          "english": "Peace be upon you, O son of `Ali the well-pleased.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ فَاطِمَةَ ٱلزَّهْرَاءِ",
          "transliteration": "alssalamu `alayka yabna fatimata alzzahra'i",
          "english": "Peace be upon you, O son of Fatimah the luminous lady.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا بْنَ خَدِيـجَةَ ٱلْكُبْرَىٰ",
          "transliteration": "alssalamu `alayka yabna khadijata alkubra",
          "english": "Peace be upon you, O son of Khadijah the grand lady.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "اَلسَّلاَمُ عَلَيْكَ يَا ثَارَ ٱللَّهِ وَٱبْنَ ثَارِهِ",
          "transliteration": "alssalamu `alayka ya thara allahi wabna tharihi",
          "english": "Peace be upon you, O vengeance of Allah, son of His vengeance,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَٱلْوِتْرَ ٱلْمَوْتُورَ",
          "transliteration": "walwitra almawtura",
          "english": "and the unavenged so far.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "أَشْهَدُ أَنَّكَ قَدْ أَقَمْتَ ٱلصَّلاَةَ",
          "transliteration": "ashhadu annaka qad aqamta alssalata",
          "english": "I bear witness that you performed the prayers,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَآتَيْتَ ٱلزَّكَاةَ",
          "transliteration": "wa atayta alzzakata",
          "english": "defrayed the poor-rate,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَأَمَرْتَ بِٱلْمَعْرُوفِ",
          "transliteration": "wa amarta bilma`rufi",
          "english": "enjoined the right,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَنَهَيْتَ عَنِ ٱلْمُنْكَرِ",
          "transliteration": "wa nahayta `an almunkari",
          "english": "forbade the wrong,",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَأَطَعْتَ ٱللَّهَ وَرَسُولَهُ حَتَّىٰ أَتَاكَ ٱلْيَقِينُ",
          "transliteration": "wa ata`ta allaha wa rasulahu hatta ataka alyaqinu",
          "english": "and obeyed Allah and His Messenger until death came upon you.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "فَلَعَنَ ٱللَّهُ أُمَّةً قَتَلَتْكَ",
          "transliteration": "fala`ana allahu ummatan qatalatka",
          "english": "So, may Allah curse the people who slew you.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً ظَلَمَتْكَ",
          "transliteration": "wa la`ana allahu ummatan zalamatka",
          "english": "May Allah curse the people who persecuted you.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَلَعَنَ ٱللَّهُ أُمَّةً سَمِعَتْ بِذٰلِكَ فَرَضِيَتْ بِهِ",
          "transliteration": "wa la`ana allahu ummatan sami`at bidhalika faradiyat bihi",
          "english": "May Allah curse the people who were pleased when they had heard of that.",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "يَا مَوْلاَيَ يَا أَبَا عَبْدِ ٱللَّهِ",
          "transliteration": "ya mawlaya ya aba `abdillahi",
          "english": "O my Master, O Abu-`Abdullah!",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "أَشْهَدُ أَنَّكَ كُنْتَ نُوراً فِي ٱلأَصْلاَبِ ٱلشَّامِخَةِ",
          "transliteration": "ashhadu annaka kunta nuran fi al-aslabi alshshamikhati",
          "english": "I bear witness that you were light in the sublime loins",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَٱلأَرْحَامِ ٱلْمُطَهَّرَةِ",
          "transliteration": "wal-arhami almutahharati",
          "english": "and purified wombs;",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "لَمْ تُنَجِّسْكَ ٱلْجَاهِلِيَّةُ بِأَنْجَاسِهَا",
          "transliteration": "lam tunajjiska aljahiliyyatu bi'anjasiha",
          "english": "the impurities of the Ignorance Era could not object you to filth",
          "note": ""
        },
        {
          "title": "",
          "instruction": "",
          "repeat": "",
          "reference": "https://www.duas.org/mobile/ziyarat-imam-hussain-waritha.html",
          "arabic": "وَلَمْ تُلْبِسْكَ مِنْ مُدْلَهِمَّاتِ ثِيَابِهَا",
