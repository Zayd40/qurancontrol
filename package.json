{
  "name": "quran-recitation-display-controller",
  "version": "1.0.0",
  "description": "Local Qur'an Recitation Display Controller for OBS + mosque TVs",
  "main": "desktop/main.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "test": "node --test",
    "format:iftitah": "node tools/format-dua.js",
    "desktop": "electron .",
    "pack:win": "electron-builder --win --x64",
    "pack:dir": "electron-builder --dir"
  },
  "keywords": [
    "quran",
    "obs",
    "mosque",
    "websocket",
    "local"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "qrcode": "^1.5.4",
    "ws": "^8.18.0"
  },
  "build": {
    "appId": "org.alzahraa.qurancontrol",
    "productName": "Quran Control",
    "files": [
      "desktop/**/*",
      "server/**/*",
      "public/**/*",
      "data/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "devDependencies": {
    "electron": "^42.2.0",
    "electron-builder": "^26.8.1"
  }
}
